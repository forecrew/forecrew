# Secrets for docker-compose.yml. Copy to .env, fill in, keep it out of git.

# Password of the bundled Postgres.
POSTGRES_PASSWORD=change-me

# GitHub App private key (PEM) on one line, with \n for the line breaks, in
# double quotes.
FORECREW_GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
FORECREW_GITHUB_WEBHOOK_SECRET=change-me

# The access key of the artifact store (Garage). forecrewd reads it from here
# (the evidence section of forecrew.yaml) and garage-init creates it in Garage
# on first start. Generate it once:
#   FORECREW_EVIDENCE_ACCESS_KEY_ID      GK followed by openssl rand -hex 12
#   FORECREW_EVIDENCE_SECRET_ACCESS_KEY  openssl rand -hex 32
# Garage only accepts that shape. Garage's own secrets are in garage.env.
FORECREW_EVIDENCE_ACCESS_KEY_ID=GKchange-me
FORECREW_EVIDENCE_SECRET_ACCESS_KEY=change-me

# Runtime credentials named by credential_env in forecrew.yaml.
ANTHROPIC_API_KEY=
CODEX_API_KEY=

# Optional.
# FORECREW_VERSION=latest
# FORECREW_HTTP_PORT=80
# FORECREW_HTTPS_PORT=443
# BACKUP_RETAIN_DAYS=14
# Control worker: jobs at once, and the forecrewd URL it reaches (the
# public URL, or http://forecrewd:80 on the Compose network; see install.md).
# FORECREW_CONTROL_MAX_JOBS=4
# FORECREW_CONTROL_SERVER_URL=http://forecrewd:80
# Optional: OpenAI key for semantic knowledge search. When set (and Postgres
# has pgvector), knowledge text, notes and search queries are sent to OpenAI.
# Key of the secret store: openssl rand -base64 32. Without it secure fields
# are off.
# FORECREW_SECRET_KEY=
# The key being rotated out, while forecrewd moves values to the new one.
# FORECREW_SECRET_KEY_PREVIOUS=
# FORECREW_EMBEDDINGS_API_KEY=
