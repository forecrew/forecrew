[
  {"name": "test connection", "method": "GET", "path": "/Users?filter=userName%20eq%20%22nobody%40acme.example%22", "status": 200, "expect": {"totalResults": 0, "Resources": []}},
  {"name": "create user", "method": "POST", "path": "/Users", "status": 201,
   "body": {"schemas": ["urn:ietf:params:scim:schemas:core:2.0:User", "urn:ietf:params:scim:schemas:extension:enterprise:2.0:User"], "externalId": "0a21f0f2-8d2a-4f8e-bf98-7363c4aed4ef",
            "userName": "ann@acme.example", "active": true, "emails": [{"primary": true, "type": "work", "value": "ann@acme.example"}], "meta": {"resourceType": "User"},
            "name": {"formatted": "Ann Smith", "familyName": "Smith", "givenName": "Ann"}, "roles": []},
   "save": {"user": "id"}, "expect": {"externalId": "0a21f0f2-8d2a-4f8e-bf98-7363c4aed4ef", "active": true}},
  {"name": "create again is a conflict", "method": "POST", "path": "/Users", "status": 409,
   "body": {"schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"], "externalId": "0a21f0f2-8d2a-4f8e-bf98-7363c4aed4ef", "userName": "ann@acme.example", "active": true}},
  {"name": "get by userName", "method": "GET", "path": "/Users?filter=userName%20eq%20%22ann%40acme.example%22", "status": 200, "expect": {"totalResults": 1, "Resources.0.id": "{{user}}"}},
  {"name": "get by externalId", "method": "GET", "path": "/Users?filter=externalId%20eq%20%220a21f0f2-8d2a-4f8e-bf98-7363c4aed4ef%22", "status": 200, "expect": {"totalResults": 1}},
  {"name": "get unknown", "method": "GET", "path": "/Users/5171a35d82074e068ce2", "status": 404, "expect": {"status": "404"}},
  {"name": "update attributes, with capitalised ops", "method": "PATCH", "path": "/Users/{{user}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"], "Operations": [
     {"op": "Replace", "path": "emails[type eq \"work\"].value", "value": "ann@acme.example"},
     {"op": "Replace", "path": "name.familyName", "value": "Jones"},
     {"op": "Add", "path": "urn:ietf:params:scim:schemas:extension:enterprise:2.0:User:manager", "value": "x"}]},
   "expect": {"name.familyName": "Jones", "name.givenName": "Ann"}},
  {"name": "rename userName", "method": "PATCH", "path": "/Users/{{user}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"], "Operations": [{"op": "Replace", "path": "userName", "value": "ann.jones@acme.example"}]},
   "expect": {"userName": "ann.jones@acme.example"}},
  {"name": "create group", "method": "POST", "path": "/Groups", "status": 201,
   "body": {"schemas": ["urn:ietf:params:scim:schemas:core:2.0:Group", "http://schemas.microsoft.com/2006/11/ResourceManagement/ADSCIM/2.0/Group"],
            "externalId": "8aa1a0c0-c4c3-4bc0-b4a5-2ef676900159", "displayName": "Engineering", "meta": {"resourceType": "Group"}},
   "save": {"group": "id"}, "expect": {"members": [], "externalId": "8aa1a0c0-c4c3-4bc0-b4a5-2ef676900159"}},
  {"name": "group without members", "method": "GET", "path": "/Groups/{{group}}?excludedAttributes=members", "status": 200, "expect": {"displayName": "Engineering", "members": null}},
  {"name": "group by displayName", "method": "GET", "path": "/Groups?excludedAttributes=members&filter=displayName%20eq%20%22Engineering%22", "status": 200, "expect": {"totalResults": 1, "Resources.0.id": "{{group}}"}},
  {"name": "rename group", "method": "PATCH", "path": "/Groups/{{group}}", "status": 204,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"], "Operations": [{"op": "Replace", "path": "displayName", "value": "Platform"}]}},
  {"name": "add members with a null $ref", "method": "PATCH", "path": "/Groups/{{group}}", "status": 204,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"], "Operations": [{"op": "Add", "path": "members", "value": [{"$ref": null, "value": "{{user}}"}]}]}},
  {"name": "member shows", "method": "GET", "path": "/Groups/{{group}}", "status": 200, "expect": {"members.0.value": "{{user}}"}},
  {"name": "remove members", "method": "PATCH", "path": "/Groups/{{group}}", "status": 204,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"], "Operations": [{"op": "Remove", "path": "members", "value": [{"$ref": null, "value": "{{user}}"}]}]}},
  {"name": "add it back", "method": "PATCH", "path": "/Groups/{{group}}", "status": 204,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"], "Operations": [{"op": "Add", "path": "members", "value": [{"$ref": null, "value": "{{user}}"}]}]}},
  {"name": "the access of the user", "hook": "grant_access"},
  {"name": "soft delete", "method": "PATCH", "path": "/Users/{{user}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"], "Operations": [{"op": "Replace", "path": "active", "value": "False"}]}, "expect": {"active": false}},
  {"name": "access ended", "hook": "access_ended"},
  {"name": "hard delete", "method": "DELETE", "path": "/Users/{{user}}", "status": 204},
  {"name": "gone", "method": "GET", "path": "/Users/{{user}}", "status": 404},
  {"name": "not listed", "method": "GET", "path": "/Users?filter=userName%20eq%20%22ann.jones%40acme.example%22", "status": 200, "expect": {"totalResults": 0}},
  {"name": "out of the group", "method": "GET", "path": "/Groups/{{group}}", "status": 200, "expect": {"members": []}},
  {"name": "comes back", "method": "POST", "path": "/Users", "status": 201,
   "body": {"schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"], "externalId": "0a21f0f2-8d2a-4f8e-bf98-7363c4aed4ef", "userName": "ann.jones@acme.example", "active": true},
   "expect": {"id": "{{user}}", "active": true}},
  {"name": "delete group", "method": "DELETE", "path": "/Groups/{{group}}", "status": 204}
]
