{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/forecrew/forecrew/docs/contracts/fleet-agent-api.schema.json",
  "title": "Fleet agent API messages",
  "description": "Request and response bodies of docs/contracts/fleet-agent-api.md. Not a document schema itself: use the $defs. Machines' shapes and images are the records of domain.Shape and domain.Image, so they are not repeated here.",
  "$defs": {
    "capabilities": {
      "type": "object",
      "description": "domain.ProviderCapabilities; see capabilities in fleet.schema.json."
    },
    "join_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "claim",
        "kind",
        "facts"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 43
        },
        "kind": {
          "enum": [
            "microvm",
            "proxmox",
            "hyperv",
            "tart",
            "aws",
            "fake"
          ]
        },
        "facts": {
          "$ref": "#/$defs/capabilities"
        }
      }
    },
    "join_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "waiting",
            "confirmed"
          ]
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "token": {
          "type": "string",
          "pattern": "^fcp_"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        }
      },
      "then": {
        "required": [
          "token"
        ]
      },
      "else": {
        "required": [
          "retry_after_seconds"
        ],
        "not": {
          "required": [
            "token"
          ]
        }
      }
    },
    "register_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities"
      ],
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        }
      }
    },
    "register_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "status",
        "limits",
        "tags",
        "poll_timeout_seconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "kind": {
          "enum": [
            "microvm",
            "proxmox",
            "hyperv",
            "tart",
            "aws",
            "fake"
          ]
        },
        "status": {
          "enum": [
            "active",
            "paused"
          ]
        },
        "limits": {
          "type": "object"
        },
        "tags": {
          "type": "object"
        },
        "poll_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "poll_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generation": {
          "type": "string",
          "description": "Opaque: sent back as it came, never ordered or parsed."
        },
        "have": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Every machine the agent has or is starting."
        }
      }
    },
    "desired_machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_id",
        "shape",
        "image",
        "tags",
        "network_allow"
      ],
      "properties": {
        "machine_id": {
          "type": "string",
          "format": "uuid"
        },
        "shape": {
          "type": "object"
        },
        "image": {
          "type": "object"
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "server_url",
            "token"
          ],
          "properties": {
            "server_url": {
              "type": "string",
              "format": "uri"
            },
            "token": {
              "type": "string",
              "pattern": "^fcb_"
            }
          }
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "network_allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "poll_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "machines"
      ],
      "properties": {
        "generation": {
          "type": "string",
          "description": "Opaque: sent back as it came, never ordered or parsed."
        },
        "machines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/desired_machine"
          }
        },
        "image_builds": {
          "type": "array",
          "description": "Windows image builds the agent should do or start; absent when there is none.",
          "items": {
            "$ref": "#/$defs/image_build_request"
          }
        }
      }
    },
    "state_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "booting",
            "destroyed",
            "failed"
          ]
        },
        "external_id": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "string",
          "maxLength": 2000
        },
        "abuse": {
          "enum": [
            "cpu",
            "mining"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "booting"
              }
            }
          },
          "then": {
            "required": [
              "external_id"
            ]
          }
        },
        {
          "if": {
            "required": [
              "abuse"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "failed"
              }
            }
          }
        }
      ]
    },
    "image_build_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "version",
        "iso",
        "iso_checksum",
        "license_confirmed",
        "chocolatey_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "requested",
            "running"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        },
        "iso": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute path of the ISO on the agent's host."
        },
        "iso_checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "license_confirmed": {
          "const": true,
          "description": "A person stated that their licence covers building and running the image."
        },
        "chocolatey_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "windows_image_name": {
          "type": "string"
        }
      }
    },
    "image_build_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "step",
        "percent"
      ],
      "properties": {
        "state": {
          "enum": [
            "running",
            "done",
            "failed"
          ]
        },
        "step": {
          "type": "string",
          "maxLength": 1024
        },
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "error": {
          "type": "string",
          "maxLength": 2000
        },
        "manifest": {
          "type": "string",
          "maxLength": 1024,
          "description": "Path of the unsigned manifest on the agent's host."
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "done"
              }
            }
          },
          "then": {
            "required": [
              "manifest",
              "digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_id",
        "running"
      ],
      "properties": {
        "external_id": {
          "type": "string",
          "minLength": 1
        },
        "machine_id": {
          "type": "string",
          "format": "uuid"
        },
        "running": {
          "type": "boolean"
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "reconcile_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instances"
      ],
      "properties": {
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/instance"
          }
        }
      }
    },
    "reconcile_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destroy"
      ],
      "properties": {
        "destroy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
