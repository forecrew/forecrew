[
  {"name": "startup check of users", "method": "GET", "path": "/Users?startIndex=1&count=2", "status": 200, "expect": {"totalResults": 0, "startIndex": 1, "itemsPerPage": 0}},
  {"name": "startup check of groups", "method": "GET", "path": "/Groups?startIndex=1&count=100", "status": 200, "expect": {"totalResults": 0}},
  {"name": "lookup before create", "method": "GET", "path": "/Users?filter=userName%20eq%20%22test.user%40acme.example%22&startIndex=1&count=100", "status": 200, "expect": {"totalResults": 0}},
  {"name": "create user", "method": "POST", "path": "/Users", "status": 201,
   "body": {"schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"], "userName": "test.user@acme.example", "name": {"givenName": "Test", "familyName": "User"},
            "emails": [{"primary": true, "value": "test.user@acme.example", "type": "work"}], "displayName": "Test User", "locale": "en-US",
            "externalId": "00ujl29u0le5T6Aj10h7", "groups": [], "password": "1mz050nq", "active": true},
   "save": {"user": "id"},
   "expect": {"userName": "test.user@acme.example", "active": true, "externalId": "00ujl29u0le5T6Aj10h7", "name.familyName": "User", "name.givenName": "Test", "meta.resourceType": "User"}},
  {"name": "create again is a conflict", "method": "POST", "path": "/Users", "status": 409,
   "body": {"schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"], "userName": "test.user@acme.example", "active": true}, "expect": {"status": "409", "scimType": "uniqueness"}},
  {"name": "lookup after create", "method": "GET", "path": "/Users?filter=userName%20eq%20%22TEST.user%40acme.example%22&startIndex=1&count=100", "status": 200,
   "expect": {"totalResults": 1, "Resources.0.id": "{{user}}"}},
  {"name": "get user", "method": "GET", "path": "/Users/{{user}}", "status": 200, "expect": {"id": "{{user}}"}},
  {"name": "replace user", "method": "PUT", "path": "/Users/{{user}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"], "id": "{{user}}", "userName": "test.user@acme.example", "name": {"givenName": "Another", "familyName": "User"},
            "emails": [{"primary": true, "value": "test.user@acme.example", "type": "work"}], "displayName": "Another User", "externalId": "00ujl29u0le5T6Aj10h7", "active": true},
   "expect": {"name.givenName": "Another", "active": true}},
  {"name": "create group", "method": "POST", "path": "/Groups", "status": 201,
   "body": {"schemas": ["urn:ietf:params:scim:schemas:core:2.0:Group"], "displayName": "Test SCIMv2", "members": []}, "save": {"group": "id"}, "expect": {"displayName": "Test SCIMv2"}},
  {"name": "group lookup", "method": "GET", "path": "/Groups?filter=displayName%20eq%20%22Test%20SCIMv2%22&startIndex=1&count=100", "status": 200, "expect": {"totalResults": 1, "Resources.0.id": "{{group}}"}},
  {"name": "add a member", "method": "PATCH", "path": "/Groups/{{group}}", "status": 204,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"], "Operations": [{"op": "add", "path": "members", "value": [{"value": "{{user}}", "display": "test.user@acme.example"}]}]}},
  {"name": "get group", "method": "GET", "path": "/Groups/{{group}}", "status": 200, "expect": {"members.0.value": "{{user}}", "members.0.display": "test.user@acme.example"}},
  {"name": "rename with an object", "method": "PATCH", "path": "/Groups/{{group}}", "status": 204,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"], "Operations": [{"op": "replace", "value": {"id": "{{group}}", "displayName": "Renamed"}}]}},
  {"name": "remove the member by filter", "method": "PATCH", "path": "/Groups/{{group}}", "status": 204,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"], "Operations": [{"op": "remove", "path": "members[value eq \"{{user}}\"]"}]}},
  {"name": "the group is empty and renamed", "method": "GET", "path": "/Groups/{{group}}", "status": 200, "expect": {"displayName": "Renamed", "members": []}},
  {"name": "the access of the user", "hook": "grant_access"},
  {"name": "deactivate without a path", "method": "PATCH", "path": "/Users/{{user}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"], "Operations": [{"op": "replace", "value": {"active": false}}]}, "expect": {"active": false}},
  {"name": "access ended", "hook": "access_ended"},
  {"name": "still listed", "method": "GET", "path": "/Users/{{user}}", "status": 200, "expect": {"active": false}},
  {"name": "reactivate", "method": "PATCH", "path": "/Users/{{user}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"], "Operations": [{"op": "replace", "value": {"active": true}}]}, "expect": {"active": true}},
  {"name": "delete group", "method": "DELETE", "path": "/Groups/{{group}}", "status": 204},
  {"name": "group gone", "method": "GET", "path": "/Groups/{{group}}", "status": 404, "expect": {"status": "404"}}
]
