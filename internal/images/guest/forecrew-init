#!/bin/sh
# PID 1 of a Forecrew microVM (kernel command line: init=/opt/forecrew/forecrew-init).
# It mounts what a Linux guest needs, brings up the network from the command
# line, copies the settings the provider put on its config disk into RAM,
# runs the worker and powers the machine off when the worker ends: a machine
# lives for its jobs and is thrown away.
#
# Kernel command line, all optional:
#   forecrew.ip=10.0.2.15/24  forecrew.gw=10.0.2.2  forecrew.dns=10.0.2.3
#       static network (the kernel's own ip= works too and is left alone)
#   forecrew.config=/dev/vdb  the config disk, an ext4 or vfat filesystem
#       holding bootstrap.env (default /dev/vdb)
# /etc/forecrew/modules lists kernel modules (one path per line) to load
# first, for kernels that do not have virtio built in.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

say() { echo "forecrew-init: $*" >/dev/console 2>&1 || echo "forecrew-init: $*"; }

mounted() { grep -q " $1 " /proc/mounts 2>/dev/null; }

[ -d /proc/self ] || mount -t proc proc /proc
mounted /sys || mount -t sysfs sysfs /sys
mounted /dev || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm /run /tmp
mounted /dev/pts || mount -t devpts devpts /dev/pts
mounted /dev/shm || mount -t tmpfs tmpfs /dev/shm
mounted /run || mount -t tmpfs -o mode=0755 tmpfs /run
mounted /tmp || mount -t tmpfs tmpfs /tmp
mount -o remount,rw / 2>/dev/null
hostname forecrew 2>/dev/null

cmdline_value() {
	# shellcheck disable=SC2013 # the command line is words, not lines
	for word in $(cat /proc/cmdline); do
		case $word in
		"$1"=*) echo "${word#*=}" && return ;;
		esac
	done
}

if [ -f /etc/forecrew/modules ]; then
	while IFS= read -r m || [ -n "$m" ]; do
		case $m in
		'' | '#'*) ;;
		*) insmod "$m" 2>/dev/null || say "could not load $m" ;;
		esac
	done </etc/forecrew/modules
fi

ip_addr=$(cmdline_value forecrew.ip)
if [ -n "$ip_addr" ]; then
	nic=""
	for n in /sys/class/net/*; do
		[ "${n##*/}" = lo ] || { nic=${n##*/} && break; }
	done
	if [ -n "$nic" ]; then
		ip link set lo up
		ip link set "$nic" up
		ip addr add "$ip_addr" dev "$nic"
		gw=$(cmdline_value forecrew.gw)
		[ -z "$gw" ] || ip route add default via "$gw"
		dns=$(cmdline_value forecrew.dns)
		[ -z "$dns" ] || echo "nameserver $dns" >/etc/resolv.conf
	else
		say "no network device for forecrew.ip"
	fi
fi

mkdir -p /run/forecrew
chmod 0700 /run/forecrew
disk=$(cmdline_value forecrew.config)
disk=${disk:-/dev/vdb}
if [ -b "$disk" ]; then
	mkdir -p /run/forecrew-config
	if mount -o ro "$disk" /run/forecrew-config 2>/dev/null; then
		if [ -f /run/forecrew-config/bootstrap.env ]; then
			(umask 077 && cat /run/forecrew-config/bootstrap.env >/run/forecrew/bootstrap.env)
		fi
		umount /run/forecrew-config
	else
		say "cannot mount the config disk $disk"
	fi
fi

/opt/forecrew/forecrew-start
code=$?
say "forecrew-worker ended with status $code"

sync
poweroff -f 2>/dev/null
reboot -f 2>/dev/null
echo 1 >/proc/sys/kernel/sysrq 2>/dev/null
echo o >/proc/sysrq-trigger 2>/dev/null
while :; do sleep 3600; done
