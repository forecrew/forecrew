# Secrets of Garage, the artifact store of docker-compose.yml. Copy to
# garage.env and fill in. Only the garage and garage-init services read this
# file; forecrewd does not (it gets only the evidence keys from .env).
#   GARAGE_RPC_SECRET   openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN  openssl rand -hex 32
GARAGE_RPC_SECRET=change-me
GARAGE_ADMIN_TOKEN=change-me
