{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/forecrew/forecrew/docs/contracts/model-catalog.schema.json",
  "title": "Forecrew model catalog",
  "description": "Schema of packs/catalog/models.yaml: the model providers and models Forecrew knows (plan decision 35). It ships with each release and is never fetched at run time. A provider names the adapter that runs it, the default endpoint, the variable of its key, how its models are listed and the country its hosted API runs in; a model names its maker, a suggested tier, its context size and its price. A model that is not listed works, with maker, tier and price entered by hand.",
  "type": "object",
  "required": ["version", "makers", "providers", "models"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "makers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "title", "prefixes"],
        "additionalProperties": false,
        "properties": {
          "name": {"$ref": "#/$defs/name"},
          "title": {"type": "string", "minLength": 1},
          "prefixes": {
            "description": "Starts of a model's name, after any provider part, that only this maker's models have; how a model not in the list gets its maker.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"}
          }
        }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "title", "adapter", "key_env", "homepage", "country"],
        "additionalProperties": false,
        "properties": {
          "name": {"description": "The vendor of a connection to this provider.", "$ref": "#/$defs/name"},
          "title": {"type": "string", "minLength": 1},
          "adapter": {"description": "The agent that runs its models.", "type": "string", "enum": ["claude-code", "codex", "opencode"]},
          "base_url": {"description": "The endpoint of its hosted API; absent when every account has its own (Bedrock, Azure, Vertex).", "type": "string", "pattern": "^https?://[^\\s@?#{}]+$"},
          "key_env": {"description": "The variable the agent reads the key from.", "type": "string", "pattern": "^[A-Z][A-Z0-9_]*_KEY$"},
          "models_endpoint": {
            "description": "How the key check lists its models: GET base_url + path. Absent when it has no list.",
            "type": "object",
            "required": ["path", "auth", "format"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "pattern": "^/[A-Za-z0-9/._-]*$"},
              "auth": {"description": "How the key is sent.", "type": "string", "enum": ["bearer", "x-api-key", "api-key", "none"]},
              "format": {"description": "anthropic: {data: [{id}]}; openai: {data: [{id}]} or {models: [{name}]}.", "type": "string", "enum": ["anthropic", "openai"]}
            }
          },
          "homepage": {"type": "string", "pattern": "^https://[^\\s@]+$"},
          "country": {"description": "ISO 3166-1 alpha-2 code of the country its hosted API runs in; region when the account picks it; local for a model on your own machines.", "type": "string", "pattern": "^([A-Z]{2}|region|local)$"},
          "router": {"description": "It serves models of other makers.", "type": "boolean"}
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "maker", "tier", "context", "price"],
        "additionalProperties": false,
        "properties": {
          "id": {"description": "The model's name with its provider part removed, dots as dashes.", "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "maker": {"$ref": "#/$defs/name"},
          "tier": {"type": "string", "enum": ["fast", "strong", "best"]},
          "context": {"description": "Context window in tokens.", "type": "integer", "minimum": 1},
          "price": {
            "description": "US dollars per million tokens.",
            "type": "object",
            "required": ["input", "output"],
            "additionalProperties": false,
            "properties": {
              "input": {"type": "number", "minimum": 0},
              "output": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
  }
}
