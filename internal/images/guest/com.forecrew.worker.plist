<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- forecrew-worker on a macOS Forecrew machine. The provider writes
     /var/run/forecrew/bootstrap.env into the running machine (tart exec) once it
     is assigned; forecrew-start reads and deletes it, so the job starts when the
     file appears and runs once. The folder is mode 0700 root on the machine's
     own disk, not in RAM: it never goes in the image or a shared folder, and
     the disk is destroyed with the machine. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.forecrew.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/forecrew/forecrew-start</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FORECREW_BOOTSTRAP_ENV</key>
    <string>/var/run/forecrew/bootstrap.env</string>
    <key>FORECREW_WORK_DIR</key>
    <string>/var/lib/forecrew-worker/work</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>KeepAlive</key>
  <dict>
    <key>PathState</key>
    <dict>
      <key>/var/run/forecrew/bootstrap.env</key>
      <true/>
    </dict>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/var/log/forecrew-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/forecrew-worker.log</string>
</dict>
</plist>
